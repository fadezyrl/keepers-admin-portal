# ---------------------------------------------------------------------------
# Keepers Adventures API — environment variable NAMES only
# Copy to .env and fill values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection (Supabase pooler or direct). Alias supported: database_url
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project (Auth + Storage). Service role is BACKEND ONLY.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_never_expose_to_clients

# Optional: JWT secret from Supabase Project Settings → API (HS256 legacy).
# If unset, tokens are verified via supabase.auth.getUser().
# SUPABASE_JWT_SECRET=

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limits
MAX_UPLOAD_BYTES=52428800

# Password-reset deep link opened by the mobile app (must also be allow-listed in Supabase Auth URL config)
MOBILE_RESET_REDIRECT_URL=keepers://auth/reset-password

# Next.js on-demand revalidation webhook (Admin Portal).
# NEXT_REVALIDATE_URL should point at the Admin frontend /api/revalidate route.
# REVALIDATE_SECRET must match the frontend server-only REVALIDATE_SECRET (never expose to browser).
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string
